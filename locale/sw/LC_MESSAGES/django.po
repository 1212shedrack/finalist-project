msgstr "Uchambuzi umeshindwa: %(error)s"

msgid "Analysis complete: %(name)s detected (%(conf).1f%% confidence)"
msgstr "Uchambuzi umekamilika: %(name)s imegunduliwa (uhakika wa %(conf).1f%%)"

msgid "Prediction deleted successfully."
msgstr "Utabiri umefutwa kwa mafanikio."

msgid "Fungal: Medium Risk"
msgstr "Ukungu: Hatari ya Wastani"

msgid "Oomycete: High Risk"
msgstr "Oomycete: Hatari Kubwa"

